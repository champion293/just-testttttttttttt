# Mateen Cloud - environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- Cloud storage provider (optional) ---
# Mateen Cloud ships with a working LOCAL storage adapter out of the box
# (see services/cloudProvider.js). If/when you identify the real provider
# these credentials belong to, fill these in and flip CLOUD_PROVIDER below.
CLOUD_PROVIDER=local
CLOUD_API_URL=https://your-provider-api-url
CLOUD_API_KEY=your_api_key
CLOUD_API_SECRET=your_api_secret

# --- Server ---
PORT=3000
NODE_ENV=development

# Max upload size in MB
MAX_UPLOAD_MB=200

# Total storage quota shown in the UI (GB), used by the local adapter
STORAGE_QUOTA_GB=15
